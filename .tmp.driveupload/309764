m Salesforce, SAP e sistemas legados via REST</CheckItem>\n                        <CheckItem>SDK disponível para Node.js e Python (em breve)</CheckItem>\n                        <CheckItem>Rate limiting, throttling e logs de requisições incluídos</CheckItem>\n                        <div style={{ marginTop: 32, display: 'flex', gap: 12, flexWrap: 'wrap' }}>\n                            <a href=\"/contato\" className=\"btn-hero-blue\" style={{ padding: '12px 26px', fontSize: 14, background: 'linear-gradient(135deg, #7c3aed, #9b59f5)', boxShadow: '0 8px 24px rgba(124,58,237,0.3)' }}>\n                                Falar com a equipe técnica\n                            </a>\n                            <a href=\"/servicos\" className=\"btn-hero-outline\" style={{ padding: '11px 24px', fontSize: 14 }}>Ver serviços</a>\n                        </div>\n                    </div>\n                    {/* Code snippet */}\n                    <div className=\"api-code\">\n                        <div className=\"api-code-header\">\n                            {['#ff5f57','#febc2e','#28c840'].map(c => <span key={c} className=\"api-code-dot\" style={{ background: c }} />)}\n                            <span style={{ marginLeft: 8, fontSize: 11, color: '#8b949e' }}>nodal-api · webhook.example.ts</span>\n                        </div>\n                        <div className=\"api-code-body\">\n                            <div><span className=\"c-gray\">// Webhook recebido do Nodal</span></div>\n                            <div style={{ marginTop: 12 }}>\n                                <span className=\"c-purple\">POST</span> <span className=\"c-green\">/webhook/nodal</span>\n                            </div>\n                            <div style={{ margin: '14px 0' }}>\n                                <span className=\"c-white\">{'{'}</span><br />\n                                <span className=\"c-blue\">&nbsp;&nbsp;\"event\"</span><span className=\"c-white\">: </span><span className=\"c-orange\">\"user.created\"</span><span className=\"c-white\">,</span><br />\n                                <span className=\"c-blue\">&nbsp;&nbsp;\"timestamp\"</span><span className=\"c-white\">: </span><span className=\"c-orange\">\"2026-08-19T12:00:00Z\"</span><span className=\"c-white\">,</span><br />\n                                <span className=\"c-blue\">&nbsp;&nbsp;\"data\"</span><span className=\"c-white\">: {'{'}</span><br />\n                                <span className=\"c-blue\">&nbsp;&nbsp;&nbsp;&nbsp;\"id\"</span><span className=\"c-white\">: </span><span className=\"c-orange\">\"usr_01jz...\"</span><span className=\"c-white\">,</span><br />\n                                <span className=\"c-blue\">&nbsp;&nbsp;&nbsp;&nbsp;\"name\"</span><span className=\"c-white\">: </span><span className=\"c-orange\">\"Carlos Lima\"</span><span className=\"c-white\">,</span><br />\n                                <span className=\"c-blue\">&nbsp;&nbsp;&nbsp;&nbsp;\"email\"</span><span className=\"c-white\">: </span><span className=\"c-orange\">\"carlos@empresa.com\"</span><span className=\"c-white\">,</span><br />\n                                <span className=\"c-blue\">&nbsp;&nbsp;&nbsp;&nbsp;\"role\"</span><span className=\"c-white\">: </span><span className=\"c-orange\">\"developer\"</span><br />\n                                <span className=\"c-white\">&nbsp;&nbsp;{'}'}</span><br />\n                                <span className=\"c-white\">{'}'}</span>\n                            </div>\n                            <div style={{ marginTop: 12 }}>\n                                <span className=\"c-gray\">// Autenticação da requisição</span><br />\n                                <span className=\"c-blue\">X-Nodal-Signature</span><span className=\"c-white\">: </span><span className=\"c-green\">sha256=abc123...</span>\n                            </div>\n                            <div style={{ marginTop: 12 }}>\n           